{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    /*
     * `vite.config.ts` imports its two plugins with a `.ts` extension, which
     * Vite 8's native config loader requires and which this flag is what
     * permits. Safe here because nothing in this project is emitted by tsc —
     * Vite does the building, and `noEmit` above is what makes that true.
     */
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "harness", "vite-plugins", "vite.config.ts", "harness/vite.config.ts"]
}
